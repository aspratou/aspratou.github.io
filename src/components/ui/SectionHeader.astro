---
import Link from "./link/Link.astro";

interface Props {
    title: string;
    href: string;
    viewAllText?: string;
}
const { title, href, viewAllText = "View all &rarr;" } = Astro.props;
---

<div class="mb-8">
    <div class="flex items-center justify-between mb-4">
        <h2 class="flex items-center gap-3 text-3xl font-bold">
            <span class="inline-block w-1 h-8 bg-yellow-400 rounded-full"></span>
            {title}
        </h2>
        <Link variant="hover-reveal" {href}>
            {viewAllText}
        </Link>
    </div>
    <hr class="border-neutral-700 dark:border-neutral-600" />
</div>　