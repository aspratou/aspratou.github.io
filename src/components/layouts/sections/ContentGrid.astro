---
import Card from "../../content/Card.astro";
import ListCard from "../../content/ListCard.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import { cn } from "../../../utils/styles";
import type { ContentEntry, WithMeta } from "../../../types";

interface Props {
    items: WithMeta<ContentEntry>[];
    class?: string;
    title?: string;
    href?: string;
    viewAllText?: string;
    eagerLoadCount?: number;
    variant?: "grid" | "list" | "tabs";
    tabItems?: Record<string, WithMeta<ContentEntry>[]>;
}

const {
    title,
    href,
    viewAllText,
    items,
    class: cls,
    eagerLoadCount = 0,
    variant = "grid",
    tabItems,
} = Astro.props;

if (!items || items.length === 0) return null;

const TAB_LABELS: Record<string, string> = {
    diary: "Diary",
    book: "Book",
    game: "Game",
    english: "English",
    mmd: "MMD",
};

const tabKeys = tabItems ? Object.keys(tabItems) : [];
const firstKey = tabKeys[0];
---

<section>
    {title && href && <SectionHeader {title} {href} {viewAllText} />}

    {variant === "tabs" && tabItems ? (
        <div class="js-tabs">
            {/* タブボタン */}
            <div class="flex flex-wrap gap-2 mb-6">
                {tabKeys.map((key) => (
                    <button
                        type="button"
                        data-tab-button={key}
                        class={cn(
                            "rounded-full px-4 py-1.5 text-sm font-medium transition-colors duration-200",
                            key === firstKey
                                ? "bg-[#3EA8FF] text-white"
                                : "bg-[#F0F4F8] text-gray-600 hover:bg-[#E2E8F0] dark:bg-[#2C2C30] dark:text-gray-300 dark:hover:bg-[#37373C]",
                        )}
                    >
                        {TAB_LABELS[key] ?? key}
                    </button>
                ))}
            </div>

            {/* タブコンテンツ */}
            {Object.entries(tabItems).map(([key, tabEntries]) => (
                <div
                    data-tab-panel={key}
                    class={key === firstKey ? "" : "hidden"}
                >
                    <div class="flex flex-col divide-y divide-[#E2E8F0] dark:divide-[#2C2C30]">
                        {tabEntries.map((item, index) => (
                            <ListCard
                                entry={item}
                                loading={index < eagerLoadCount ? "eager" : "lazy"}
                            />
                        ))}
                    </div>
                    <div class="mt-4 text-right">
                        <a
                            href={`/${key}`}
                            class="text-sm text-[#3EA8FF] hover:underline"
                        >
                            View all {TAB_LABELS[key] ?? key} →
                        </a>
                    </div>
                </div>
            ))}
        </div>
    ) : variant === "list" ? (
        <div class="flex flex-col divide-y divide-[#E2E8F0] dark:divide-[#2C2C30]">
            {items.map((item, index) => (
                <ListCard
                    entry={item}
                    loading={index < eagerLoadCount ? "eager" : "lazy"}
                />
            ))}
        </div>
    ) : (
        <div
            class={cn(
                "grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3",
                cls,
            )}
        >
            {items.map((item, index) => (
                <Card
                    entry={item}
                    loading={index < eagerLoadCount ? "eager" : "lazy"}
                />
            ))}
        </div>
    )}
</section>

<script>
    function initTabs(container: HTMLElement) {
        const buttons = container.querySelectorAll<HTMLButtonElement>(
            "[data-tab-button]",
        );
        const panels = container.querySelectorAll<HTMLElement>(
            "[data-tab-panel]",
        );

        buttons.forEach((button) => {
            button.addEventListener("click", () => {
                const key = button.dataset.tabButton;

                buttons.forEach((b) => {
                    const active = b.dataset.tabButton === key;
                    b.classList.toggle("bg-[#3EA8FF]", active);
                    b.classList.toggle("text-white", active);
                    b.classList.toggle("bg-[#F0F4F8]", !active);
                    b.classList.toggle("text-gray-600", !active);
                    b.classList.toggle("dark:bg-[#2C2C30]", !active);
                    b.classList.toggle("dark:text-gray-300", !active);
                });

                panels.forEach((panel) => {
                    panel.classList.toggle(
                        "hidden",
                        panel.dataset.tabPanel !== key,
                    );
                });
            });
        });
    }

    document
        .querySelectorAll<HTMLElement>(".js-tabs")
        .forEach((container) => initTabs(container));
</script>