---
import Card from "../../content/Card.astro";
import ListCard from "../../content/ListCard.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import { cn } from "../../../utils/styles";
import type { ContentEntry, WithMeta } from "../../../types";

interface Props {
    items: WithMeta<ContentEntry>[];
    class?: string;
    title?: string;
    href?: string;
    viewAllText?: string;
    eagerLoadCount?: number;
    variant?: "grid" | "list";
}

const {
    title,
    href,
    viewAllText,
    items,
    class: cls,
    eagerLoadCount = 0,
    variant = "grid",
} = Astro.props;

if (!items || items.length === 0) return null;
---

<section>
    {title && href && <SectionHeader {title} {href} {viewAllText} />}

    {variant === "list" ? (
        <div class="flex flex-col divide-y divide-neutral-700 dark:divide-neutral-600">
            {items.map((item, index) => (
                <ListCard
                    entry={item}
                    loading={index < eagerLoadCount ? "eager" : "lazy"}
                />
            ))}
        </div>
    ) : (
        <div
            class={cn(
                "grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3",
                cls,
            )}
        >
            {items.map((item, index) => (
                <Card
                    entry={item}
                    loading={index < eagerLoadCount ? "eager" : "lazy"}
                />
            ))}
        </div>
    )}
</section>