---
import Card from "../../content/Card.astro";
import ListCard from "../../content/ListCard.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import { cn } from "../../../utils/styles";
import type { ContentEntry, WithMeta } from "../../../types";

interface Props {
    items: WithMeta<ContentEntry>[];
    class?: string;
    title?: string;
    href?: string;
    viewAllText?: string;
    eagerLoadCount?: number;
    variant?: "grid" | "list" | "tabs";
    tabItems?: Record<string, WithMeta<ContentEntry>[]>;
}

const {
    title,
    href,
    viewAllText,
    items,
    class: cls,
    eagerLoadCount = 0,
    variant = "grid",
    tabItems,
} = Astro.props;

if (!items || items.length === 0) return null;

const TAB_LABELS: Record<string, string> = {
    diary: "Diary",
    book: "Book",
    game: "Game",
    english: "English",
};

const tabKeys = tabItems ? Object.keys(tabItems) : [];
const firstKey = tabKeys[0];
---

<section>
    {title && href && <SectionHeader {title} {href} {viewAllText} />}

    {variant === "tabs" && tabItems ? (
        <div class="js-tabs">
            {/* タブボタン */}
            <div class="flex gap-0 border-b border-[#E2E8F0] dark:border-[#2C2C30] mb-2">
                {tabKeys.map((key) => (
                    <button
                        type="button"
                        data-tab-button={key}
                        class={cn(
                            "px-4 py-2 text-sm transition-colors duration-200 -mb-px border-b-2",
                            key === firstKey
                                ? "border-[#3EA8FF] text-[#3EA8FF] font-semibold"
                                : "border-transparent text-gray-500 hover:text-[#3EA8FF]",
                        )}
                    >
                        {TAB_LABELS[key] ?? key}
                    </button>
                ))}
            </div>

            {/* タブコンテンツ */}
            {Object.entries(tabItems).map(([key, tabEntries]) => (
                <div
                    data-tab-panel={key}
                    class={key === firstKey ? "" : "hidden"}
                >
                    <div class="flex flex-col divide-y divide-[#E2E8F0] dark:divide-[#2C2C30]">
                        {tabEntries.map((item, index) => (
                            <ListCard
                                entry={item}
                                loading={index < eagerLoadCount ? "eager" : "lazy"}
                            />
                        ))}
                    </div>
                    <div class="mt-4 text-right">
                        <a
                            href={`/${key}`}
                            class="text-sm text-[#3EA8FF] hover:underline"
                        >
                            View all {TAB_LABELS[key] ?? key} →
                        </a>
                    </div>
                </div>
            ))}
        </div>
    ) : variant === "list" ? (
        <div class="flex flex-col divide-y divide-[#E2E8F0] dark:divide-[#2C2C30]">
            {items.map((item, index) => (
                <ListCard
                    entry={item}
                    loading={index < eagerLoadCount ? "eager" : "lazy"}
                />
            ))}
        </div>
    ) : (
        <div
            class={cn(
                "grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3",
                cls,
            )}
        >
            {items.map((item, index) => (
                <Card
                    entry={item}
                    loading={index < eagerLoadCount ? "eager" : "lazy"}
                />
            ))}
        </div>
    )}
</section>

<script>
    function initTabs(container: HTMLElement) {
        const buttons = container.querySelectorAll<HTMLButtonElement>(
            "[data-tab-button]",
        );
        const panels = container.querySelectorAll<HTMLElement>(
            "[data-tab-panel]",
        );

        buttons.forEach((button) => {
            button.addEventListener("click", () => {
                const key = button.dataset.tabButton;

                buttons.forEach((b) => {
                    const active = b.dataset.tabButton === key;
                    b.classList.toggle("border-[#3EA8FF]", active);
                    b.classList.toggle("text-[#3EA8FF]", active);
                    b.classList.toggle("font-semibold", active);
                    b.classList.toggle("border-transparent", !active);
                    b.classList.toggle("text-gray-500", !active);
                });

                panels.forEach((panel) => {
                    panel.classList.toggle(
                        "hidden",
                        panel.dataset.tabPanel !== key,
                    );
                });
            });
        });
    }

    document
        .querySelectorAll<HTMLElement>(".js-tabs")
        .forEach((container) => initTabs(container));
</script>