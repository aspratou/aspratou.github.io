---
import Card from "../../content/Card.astro";
import ListCard from "../../content/ListCard.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import { cn } from "../../../utils/styles";
import type { ContentEntry, WithMeta } from "../../../types";

interface Props {
    items: WithMeta<ContentEntry>[];
    class?: string;
    title?: string;
    href?: string;
    viewAllText?: string;
    eagerLoadCount?: number;
    variant?: "grid" | "list" | "tabs";
    tabItems?: Record<string, WithMeta<ContentEntry>[]>;
}

const {
    title,
    href,
    viewAllText,
    items,
    class: cls,
    eagerLoadCount = 0,
    variant = "grid",
    tabItems,
} = Astro.props;

if (!items || items.length === 0) return null;

const TAB_LABELS: Record<string, string> = {
    diary: "Diary",
    book: "Book",
    game: "Game",
    english: "English",
};
---

<section>
    {title && href && <SectionHeader {title} {href} {viewAllText} />}

    {variant === "tabs" && tabItems ? (
        <div x-data={`{ activeTab: '${Object.keys(tabItems)[0]}' }`}>
            {/* タブボタン */}
            <div class="flex gap-0 border-b border-[#E2E8F0] dark:border-neutral-700 mb-2">
                {Object.keys(tabItems).map((key) => (
                    <button
                        x-on:click={`activeTab = '${key}'`}
                        x-bind:class={`activeTab === '${key}' ? 'border-b-2 border-[#3EA8FF] text-[#3EA8FF] font-semibold' : 'text-gray-500 hover:text-[#3EA8FF]'`}
                        class="px-4 py-2 text-sm transition-colors duration-200 -mb-px"
                    >
                        {TAB_LABELS[key] ?? key}
                    </button>
                ))}
            </div>

            {/* タブコンテンツ */}
            {Object.entries(tabItems).map(([key, tabEntries]) => (
                <div x-show={`activeTab === '${key}'`} x-cloak>
                    <div class="flex flex-col divide-y divide-[#E2E8F0] dark:divide-[#2C2C30]">
                        {tabEntries.map((item, index) => (
                            <ListCard
                                entry={item}
                                loading={index < eagerLoadCount ? "eager" : "lazy"}
                            />
                        ))}
                    </div>
                    <div class="mt-4 text-right">
                        <a
                            href={`/${key}`}
                            class="text-sm text-[#3EA8FF] hover:underline"
                        >
                            View all {TAB_LABELS[key] ?? key} →
                        </a>
                    </div>
                </div>
            ))}
        </div>
    ) : variant === "list" ? (
        <div class="flex flex-col divide-y divide-[#E2E8F0] dark:divide-neutral-700">
            {items.map((item, index) => (
                <ListCard
                    entry={item}
                    loading={index < eagerLoadCount ? "eager" : "lazy"}
                />
            ))}
        </div>
    ) : (
        <div
            class={cn(
                "grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3",
                cls,
            )}
        >
            {items.map((item, index) => (
                <Card
                    entry={item}
                    loading={index < eagerLoadCount ? "eager" : "lazy"}
                />
            ))}
        </div>
    )}
</section>