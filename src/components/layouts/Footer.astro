---
import NewsletterForm from "../forms/NewsletterForm.astro";
import BuyMeACoffee from "../integrations/BuyMeACoffee.astro";
import Link from "../ui/link/Link.astro";
import {
    footer as footerLinkSections,
    SITE_SETTINGS as site,
} from "../../site.config";
const currentYear = new Date().getFullYear();
---

<footer
    class="relative z-50 mt-24 border-t border-neutral-200 bg-white dark:border-[#2C2C30] dark:bg-[#16161A]"
>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="py-16">
            <div
                class="flex flex-wrap gap-x-12 gap-y-10 sm:flex-row sm:items-start sm:justify-between lg:flex-nowrap"
            >

                <div class="order-2 max-w-2xs space-y-4 lg:order-1">
                    <a
                        href="/about"
                        class="group block rounded-xl border border-[#E2E8F0] bg-white p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-[#3EA8FF] hover:shadow-md dark:border-[#2C2C30] dark:bg-[#242428]"
                    >
                        <div class="mb-3 flex items-center gap-3">
                            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#3EA8FF] text-white">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            </div>
                            <div>
                                <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100 group-hover:text-[#3EA8FF] transition-colors">
                                    {site.owner}
                                </h2>
                                <p class="text-xs text-gray-500 dark:text-gray-400">About me</p>
                            </div>
                        </div>
                        <p class="text-sm text-gray-600 dark:text-gray-400">
                            2児の父。日々の取り組みや日記を残しています。
                        </p>
                        <p class="mt-3 text-sm text-[#3EA8FF]">
                            プロフィールを見る →
                        </p>
                    </a>
                </div>

                {
                    footerLinkSections.map((section) => (
                        <div class="order-3 flex-1 basis-0 lg:order-2 lg:flex-none lg:basis-auto">
                            <h3 class="text-sm font-semibold tracking-wider uppercase">
                                {section.title}
                            </h3>
                            <ul class="mt-4 space-y-2">
                                {section.links.map((link) => (
                                    <li>
                                        <Link
                                            variant="plain"
                                            href={link.url}
                                            class="text-sm"
                                        >
                                            {link.name}
                                        </Link>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </div>

        <div class="border-t border-neutral-300 py-8 dark:border-[#2C2C30]">
            <div
                class="flex flex-col items-center justify-between gap-4 sm:flex-row"
            >
                <div class="space-y-1">
                    <p class="text-sm">
                        &copy; {currentYear} {site.title}. All rights reserved.
                    </p>
                    <p class="text-xs text-gray-500 dark:text-gray-400">
                        当サイトは、Amazonアソシエイト・プログラムの参加者です。
                    </p>
                </div>
                <Link variant="plain" href="/changelog" class="text-sm">
                    Changelog
                </Link>
            </div>
        </div>
    </div>
</footer>