---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/layouts/Container.astro";
import PageTitle from "../../components/ui/PageTitle.astro";
import ListCard from "../../components/content/ListCard.astro";
import EmptyState from "../../components/ui/EmptyState.astro";
import { attachMeta } from "../../utils/meta";

const posts = (await getCollection("apps", ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .map((p) => attachMeta(p));

const appPanels = [
    {
        title: "Lingoop",
        description: "続けられる英会話をコンセプトにしたiPhone向けアプリ",
        href: "/apps/eikaiwa",
        status: "制作中",
    },
];
---

<BaseLayout
    title="Apps"
    description="アプリ・ツール・ソフトウェアに関する記録。"
>
    <Container class="py-12">
        <PageTitle title="Apps" />

        <div class="flex flex-col gap-8 lg:flex-row">
            {/* 左：アプリパネル（SP時は上） */}
            <div class="w-full lg:w-72 shrink-0">
                <h2 class="mb-4 text-xl font-bold text-gray-800 dark:text-gray-100">
                    作ったもの
                </h2>
                <div class="flex flex-col gap-4">
                    {appPanels.map((app) => (
                        <a
                            href={app.href}
                            class="group block rounded-xl border border-[#E2E8F0] bg-white p-5 shadow-sm transition-shadow hover:shadow-md dark:border-[#2C2C30] dark:bg-[#242428]"
                        >
                            <div class="mb-2 flex items-center justify-between">
                                <h3 class="font-semibold text-gray-900 group-hover:text-[#3EA8FF] transition-colors dark:text-gray-100">
                                    {app.title}
                                </h3>
                                <span class="rounded-full bg-[#3EA8FF]/10 px-2 py-0.5 text-xs text-[#3EA8FF]">
                                    {app.status}
                                </span>
                            </div>
                            <p class="text-sm text-gray-500 dark:text-gray-400">
                                {app.description}
                            </p>
                            <p class="mt-3 text-sm text-[#3EA8FF]">
                                詳細を見る →
                            </p>
                        </a>
                    ))}
                </div>
            </div>

            {/* 右：制作日記一覧 */}
            <div class="flex-1 min-w-0">
                <h2 class="mb-4 text-xl font-bold text-gray-800 dark:text-gray-100">
                    制作日記
                </h2>
                {posts.length === 0 ? (
                    <EmptyState
                        title="Nothing here yet..."
                        message="Check back soon!"
                    />
                ) : (
                    <div class="flex flex-col divide-y divide-[#E2E8F0] dark:divide-[#2C2C30]">
                        {posts.map((entry) => (
                            <ListCard {entry} />
                        ))}
                    </div>
                )}
            </div>
        </div>
    </Container>
</BaseLayout>