---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/layouts/Container.astro";

const docPanels = [
    {
        title: "README",
        description: "プロジェクト構成・クイックスタート",
        href: "/apps/eikaiwa#readme",
    },
    {
        title: "PRD",
        description: "プロダクト要求仕様書",
        href: "/apps/eikaiwa#prd",
    },
    {
        title: "技術仕様",
        description: "システム構成・API・データ設計",
        href: "/apps/eikaiwa#tech",
    },
];
---

<BaseLayout
    title="Apps"
    description="作ったアプリ・ツールの記録。"
>
    <Container class="py-12">
        <h1 class="mb-10 text-3xl font-bold text-gray-900 dark:text-gray-100">Apps</h1>

        {/* ヒーローカード */}
        <div class="mb-10 overflow-hidden rounded-2xl bg-gradient-to-br from-[#3EA8FF]/10 via-white to-white p-8 dark:from-[#3EA8FF]/10 dark:via-[#1C1C1F] dark:to-[#1C1C1F] border border-[#E2E8F0] dark:border-[#2C2C30]">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
                <div>
                    <div class="mb-3 flex items-center gap-3">
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[#3EA8FF] text-2xl">
                            🗣️
                        </div>
                        <div>
                            <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Lingoop</h2>
                            <p class="text-sm text-gray-500 dark:text-gray-400">英会話アプリ</p>
                        </div>
                    </div>
                    <p class="max-w-md text-sm text-gray-600 dark:text-gray-400">
                        続けられる英会話をコンセプトにしたiPhone向けアプリ
                    </p>
                </div>

                <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-[#3EA8FF] px-4 py-1.5 text-sm font-medium text-white shrink-0">
                    <span class="h-1.5 w-1.5 rounded-full bg-white animate-pulse"></span>
                    制作中
                </span>
            </div>

            {/* 提供方法 - インラインピル */}
            <div class="mt-6 flex flex-wrap gap-3">
                <a
                    href="https://eikaiwa-app.pages.dev/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group inline-flex items-center gap-2 rounded-full bg-white dark:bg-[#242428] border border-[#E2E8F0] dark:border-[#2C2C30] px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 shadow-sm transition-all hover:border-[#3EA8FF] hover:text-[#3EA8FF] hover:shadow-md"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                    Web版で試す
                    <span class="ml-1 h-1.5 w-1.5 rounded-full bg-green-500"></span>
                </a>

                <a
                    href="/downloads/lingoop.ipa"
                    download
                    class="group inline-flex items-center gap-2 rounded-full bg-white dark:bg-[#242428] border border-[#E2E8F0] dark:border-[#2C2C30] px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 shadow-sm transition-all hover:border-[#3EA8FF] hover:text-[#3EA8FF] hover:shadow-md"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.08zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
                    iOS アプリ (.ipa) をダウンロード
                    <span class="rounded-full bg-[#3EA8FF]/10 px-2 py-0.5 text-xs text-[#3EA8FF]">AltStore対応</span>
                </a>
            </div>

            <p class="mt-3 text-xs text-gray-400 dark:text-gray-500">
                ※ iOS版は<a href="https://altstore.io/" target="_blank" rel="noopener noreferrer" class="underline hover:text-[#3EA8FF]">AltStore</a>経由でのインストールが必要です（PCとAltServerでのペアリングが必要）
            </p>
        </div>

        {/* ドキュメント一覧 */}
        <div>
            <h3 class="mb-4 text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">
                ドキュメント
            </h3>
            <div class="flex flex-col divide-y divide-[#E2E8F0] dark:divide-[#2C2C30] rounded-xl border border-[#E2E8F0] dark:border-[#2C2C30] overflow-hidden">
                {docPanels.map((panel) => (
                    <a
                        href={panel.href}
                        class="group flex items-center gap-4 bg-white dark:bg-[#242428] px-5 py-4 transition-colors hover:bg-[#F0F9FF] dark:hover:bg-[#2C2C30]"
                    >
                        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#3EA8FF]/10 text-[#3EA8FF]">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
                        </div>
                        <div class="min-w-0 flex-1">
                            <h4 class="font-semibold text-gray-900 dark:text-gray-100 group-hover:text-[#3EA8FF] transition-colors">
                                {panel.title}
                            </h4>
                            <p class="text-sm text-gray-500 dark:text-gray-400 truncate">
                                {panel.description}
                            </p>
                        </div>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-gray-300 dark:text-gray-600 transition-transform group-hover:translate-x-1 group-hover:text-[#3EA8FF]"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                ))}
            </div>
        </div>
    </Container>
</BaseLayout>