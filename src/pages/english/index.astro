---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/layouts/Container.astro";
import { attachMeta } from "../../utils/meta";

const posts = (await getCollection("english", ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .map((p) => attachMeta(p));

const TYPE_LABELS: Record<string, string> = {
    book: "📘 本",
    exam: "📝 試験",
    game: "🎮 ゲーム学習",
    note: "✍️ 学習メモ",
};

const TYPE_STYLES: Record<string, string> = {
    book: "bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400",
    exam: "bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400",
    game: "bg-[#3EA8FF]/10 text-[#3EA8FF]",
    note: "bg-gray-100 text-gray-500 dark:bg-[#2C2C30] dark:text-gray-400",
};
---

<BaseLayout
    title="English"
    description="A collection of my English learning records."
    ogImage="https://res.cloudinary.com/dellp9a4z/image/upload/v1756758388/og-projects_mj7lcc.png"
>
    <Container class="py-12">
        <h1 class="mb-8 text-3xl font-bold">English</h1>

        <div class="flex flex-col divide-y divide-[#E2E8F0] dark:divide-[#2C2C30]">
            {posts.map((post) => {
                const { title, image, pubDate, tags, englishType } = post.data;
                const { plainText } = post.meta || {};
                const typeLabel = TYPE_LABELS[englishType] ?? englishType;
                const typeStyle = TYPE_STYLES[englishType] ?? TYPE_STYLES.note;

                return (
                    <a
                        href={`/english/${post.id}`}
                        class="group flex gap-5 py-5 transition-colors hover:bg-[#F0F9FF] dark:hover:bg-[#242428] -mx-4 px-4 rounded-lg"
                    >
                        {/* サムネ */}
                        <div class="w-40 shrink-0 sm:w-56">
                            <img
                                src={image.src}
                                alt={image.alt ?? title}
                                loading="lazy"
                                class="w-full rounded-lg shadow-sm object-cover aspect-video"
                            />
                        </div>

                        {/* メタ情報 */}
                        <div class="flex flex-col justify-between min-w-0 flex-1">
                            <div>
                                <span class={`inline-block rounded-full px-2 py-0.5 text-xs mb-1 ${typeStyle}`}>
                                    {typeLabel}
                                </span>
                                <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100 group-hover:text-[#3EA8FF] transition-colors mb-1 line-clamp-2">
                                    {title}
                                </h2>
                                <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">
                                    {plainText ? plainText.slice(0, 100) : ""}
                                </p>
                            </div>

                            <div class="flex flex-wrap items-center gap-2 mt-3">
                                {tags.map((tag) => (
                                    <span class="rounded-full bg-gray-100 dark:bg-[#2C2C30] px-2 py-0.5 text-xs text-gray-500 dark:text-gray-400">
                                        {tag}
                                    </span>
                                ))}
                                <span class="text-xs text-gray-400 dark:text-gray-500">
                                    {pubDate.toLocaleDateString("ja-JP", { year: "numeric", month: "short", day: "numeric" })}
                                </span>
                            </div>
                        </div>
                    </a>
                );
            })}
        </div>
    </Container>
</BaseLayout>