---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/layouts/Container.astro";
import { attachMeta } from "../../utils/meta";

const books = (await getCollection("book", ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .map((p) => attachMeta(p));
---

<BaseLayout
    title="Book"
    description="A collection of my books."
    ogImage="https://res.cloudinary.com/dellp9a4z/image/upload/v1756758388/og-projects_mj7lcc.png"
>
    <Container class="py-12">
        <h1 class="mb-8 text-3xl font-bold">Book</h1>

        <div class="flex flex-col divide-y divide-[#E2E8F0] dark:divide-[#2C2C30]">
            {books.map((book) => {
                const { title, image, pubDate, tags, bookAuthor, rating } = book.data;
                const { plainText } = book.meta || {};
                const stars = "★".repeat(rating) + "☆".repeat(5 - rating);

                return (
                    <a
                        href={`/book/${book.id}`}
                        class="group flex gap-5 py-5 transition-colors hover:bg-[#F0F9FF] dark:hover:bg-[#242428] -mx-4 px-4 rounded-lg"
                    >
                        {/* 書影 */}
                        <div class="w-20 shrink-0 sm:w-24">
                            <img
                                src={image.src}
                                alt={image.alt ?? title}
                                loading="lazy"
                                class="w-full rounded shadow-sm object-cover aspect-[2/3]"
                            />
                        </div>

                        {/* メタ情報 */}
                        <div class="flex flex-col justify-between min-w-0 flex-1">
                            <div>
                                <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100 group-hover:text-[#3EA8FF] transition-colors mb-0.5 line-clamp-2">
                                    {title}
                                </h2>
                                <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
                                    {bookAuthor}
                                </p>
                                <p class="text-sm text-amber-500 tracking-widest mb-2">
                                    {stars}
                                </p>
                                <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">
                                    {plainText ? plainText.slice(0, 100) : ""}
                                </p>
                            </div>

                            <div class="flex flex-wrap items-center gap-2 mt-3">
                                {tags.map((tag) => (
                                    <span class="rounded-full bg-gray-100 dark:bg-[#2C2C30] px-2 py-0.5 text-xs text-gray-500 dark:text-gray-400">
                                        {tag}
                                    </span>
                                ))}
                                <span class="text-xs text-gray-400 dark:text-gray-500">
                                    {pubDate.toLocaleDateString("ja-JP", { year: "numeric", month: "short", day: "numeric" })}
                                </span>
                            </div>
                        </div>
                    </a>
                );
            })}
        </div>
    </Container>
</BaseLayout>