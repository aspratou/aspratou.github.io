---
import { getCollection } from "astro:content";
import ListLayout from "../layouts/ListLayout.astro";
import { attachMeta } from "../utils/meta";

const allDiaries = await getCollection("diary", ({ data }) => !data.draft);
const allBooks = await getCollection("book", ({ data }) => !data.draft);
const allGames = await getCollection("game", ({ data }) => !data.draft);
const allEnglish = await getCollection("english", ({ data }) => !data.draft);

const posts = [...allDiaries, ...allBooks, ...allGames, ...allEnglish]
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .map((p) => attachMeta(p));
---

<ListLayout
    title="Latest Posts"
    description="すべての投稿をまとめて新しい順に表示しています。"
    entries={posts}
/>