---
import { getCollection } from "astro:content";
import Container from "../components/layouts/Container.astro";
import ContentGrid from "../components/layouts/sections/ContentGrid.astro";
import FeaturedContent from "../components/layouts/sections/FeaturedContent.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { attachMeta } from "../utils/meta";

const allDiaries = await getCollection("diary", ({ data }) => !data.draft);
const allBooks = await getCollection("book", ({ data }) => !data.draft);
const allGames = await getCollection("game", ({ data }) => !data.draft);
const allEnglish = await getCollection("english", ({ data }) => !data.draft);

const sortByDate = (arr: typeof allDiaries) =>
    arr.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const tabItems = {
    diary: sortByDate(allDiaries).slice(0, 5).map((p) => attachMeta(p)),
    book: sortByDate(allBooks).slice(0, 5).map((p) => attachMeta(p)),
    game: sortByDate(allGames).slice(0, 5).map((p) => attachMeta(p)),
    english: sortByDate(allEnglish).slice(0, 5).map((p) => attachMeta(p)),
};

// タブ用のitemsはダミーで全件渡す（ContentGrid内ではtabItemsを使う）
const allItems = [...allDiaries, ...allBooks, ...allGames, ...allEnglish]
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .map((p) => attachMeta(p));

const featured = [...allDiaries, ...allBooks, ...allGames, ...allEnglish]
    .filter((item) => item.data.featured !== undefined)
    .sort((a, b) => (a.data.featured ?? 0) - (b.data.featured ?? 0));

const hasContent = featured.length > 0 || allItems.length > 0;
---

<BaseLayout
    title="Rato"
    description="社会システムの解説や言語のニュアンス、ゲームメカニクスまで、日々のアウトプットや探求をまとめる個人データベース。"
>
    <Container class="space-y-24 py-12">
        {
            hasContent ? (
                <>
                    {featured.length > 0 && (
                        <FeaturedContent items={featured} />
                    )}

                    {allItems.length > 0 && (
                        <ContentGrid
                            title="Latest Posts"
                            href="/posts"
                            viewAllText="View all posts →"
                            items={allItems}
                            variant="tabs"
                            tabItems={tabItems}
                        />
                    )}
                </>
            ) : (
                <EmptyState
                    title="Nothing here yet..."
                    message="Check back soon for new items!"
                />
            )
        }
    </Container>
</BaseLayout>