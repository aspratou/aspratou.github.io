---
import { getCollection } from "astro:content";
import Container from "../components/layouts/Container.astro";
import FeaturedContent from "../components/layouts/sections/FeaturedContent.astro";
import Card from "../components/content/Card.astro";
import ListCard from "../components/content/ListCard.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { attachMeta } from "../utils/meta";

const allDiaries = await getCollection("diary", ({ data }) => !data.draft);
const allBooks = await getCollection("book", ({ data }) => !data.draft);
const allGames = await getCollection("game", ({ data }) => !data.draft);
const allEnglish = await getCollection("english", ({ data }) => !data.draft);
const allApps = await getCollection("apps", ({ data }) => !data.draft);

const sortByDate = <T extends { data: { pubDate: Date } }>(arr: T[]) =>
    [...arr].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allSorted = sortByDate([...allDiaries, ...allBooks, ...allGames, ...allEnglish, ...allApps])
    .map((p) => attachMeta(p));

const heroPost = allSorted[0];
const listPosts = allSorted.slice(1, 4);

const categoryPanels = [
    {
        name: "Diary",
        href: "/diary",
        color: "#22C55E",
        icon: `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>`,
    },
    {
        name: "Book",
        href: "/book",
        color: "#F97316",
        icon: `<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>`,
    },
    {
        name: "Game",
        href: "/game",
        color: "#A855F7",
        icon: `<line x1="6" y1="12" x2="10" y2="12"/><line x1="8" y1="10" x2="8" y2="14"/><circle cx="15" cy="13" r="1"/><circle cx="18" cy="11" r="1"/><rect x="2" y="6" width="20" height="12" rx="4"/>`,
    },
    {
        name: "English",
        href: "/english",
        color: "#3EA8FF",
        icon: `<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>`,
    },
    {
        name: "Apps",
        href: "/apps",
        color: "#EC4899",
        icon: `<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>`,
    },
];

const featured = [...allDiaries, ...allBooks, ...allGames, ...allEnglish, ...allApps]
    .filter((item) => item.data.featured !== undefined)
    .sort((a, b) => (a.data.featured ?? 0) - (b.data.featured ?? 0))
    .map((p) => attachMeta(p));

const hasContent = allSorted.length > 0;
---

<BaseLayout
    title="Rato"
    description="社会システムの解説や言語のニュアンス、ゲームメカニクスまで、日々のアウトプットや探求をまとめる個人データベース。"
>
    <Container class="space-y-16 py-12">
        {
            hasContent ? (
                <>
                    {featured.length > 0 && (
                        <FeaturedContent items={featured} />
                    )}

                    {/* カテゴリカード */}
                    <section class="relative">
                        <div class="cat-scroll flex gap-3 overflow-x-auto pb-2 -mx-4 px-4 sm:mx-0 sm:px-0 sm:flex-wrap [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
                            {categoryPanels.map((cat) => (
                                <a
                                    href={cat.href}
                                    class="cat-pill group flex shrink-0 items-center gap-2.5 rounded-full border border-gray-200 bg-white py-2.5 pl-2.5 pr-5 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md dark:border-[#37373C] dark:bg-[#2C2C30]"
                                    style={`--cat-color: ${cat.color}`}
                                >
                                    <div
                                        class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-white"
                                        style={`background-color: ${cat.color}`}
                                    >
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={cat.icon} />
                                    </div>
                                    <span
                                        class="whitespace-nowrap text-sm font-medium text-gray-800 transition-colors dark:text-gray-200"
                                    >
                                        {cat.name}
                                    </span>
                                </a>
                            ))}
                        </div>
                        <div class="pointer-events-none absolute right-0 top-0 h-full w-14 bg-gradient-to-l from-[#F0F9FF] to-transparent dark:from-[#1C1C1F] sm:hidden"></div>
                        <button
                            type="button"
                            class="cat-scroll-arrow pointer-events-auto absolute right-0 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full bg-white text-gray-500 shadow-md transition-opacity dark:bg-[#2C2C30] dark:text-gray-300 sm:hidden"
                            aria-label="カテゴリをさらに見る"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                        </button>
                    </section>

                    {heroPost && (
                        <section>
                            <SectionHeader
                                title="Latest Posts"
                                href="/posts"
                                viewAllText="View all posts →"
                            />
                            <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
                                <div>
                                    <Card entry={heroPost} loading="eager" />
                                </div>
                                <div class="flex flex-col divide-y divide-[#E2E8F0] dark:divide-[#2C2C30]">
                                    {listPosts.map((post) => (
                                        <ListCard entry={post} loading="lazy" />
                                    ))}
                                </div>
                            </div>
                        </section>
                    )}

                </>
            ) : (
                <EmptyState
                    title="Nothing here yet..."
                    message="Check back soon for new items!"
                />
            )
        }
    </Container>
</BaseLayout>

<style>
    .cat-pill:hover {
        border-color: var(--cat-color);
    }
    .cat-pill:hover span {
        color: var(--cat-color);
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>(".cat-scroll").forEach((scrollEl) => {
        const section = scrollEl.closest("section");
        const arrow = section?.querySelector<HTMLButtonElement>(".cat-scroll-arrow");
        if (!arrow) return;

        arrow.addEventListener("click", () => {
            scrollEl.scrollBy({ left: 160, behavior: "smooth" });
        });

        const updateArrow = () => {
            const atEnd =
                scrollEl.scrollLeft + scrollEl.clientWidth >= scrollEl.scrollWidth - 4;
            arrow.style.opacity = atEnd ? "0" : "1";
            arrow.style.pointerEvents = atEnd ? "none" : "auto";
        };

        scrollEl.addEventListener("scroll", updateArrow);
        updateArrow();
    });
</script>